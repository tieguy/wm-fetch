#!/usr/bin/env bash
# wm-fetch — fetch from Wikimedia properties in compliance with WMF policy.
#
# Sets a compliant User-Agent (WebFetch cannot), adds maxlag to Action API
# calls, requests gzip, follows redirects (bounded), bounds every request
# in time, and honors Retry-After on 429/503 with exponential backoff.
# Requests are serial by construction: one URL per invocation.
#
# Policy: https://foundation.wikimedia.org/wiki/Policy:Wikimedia_Foundation_User-Agent_Policy
# Etiquette: https://www.mediawiki.org/wiki/API:Etiquette
#
# Usage: wm-fetch <url> [extra curl args...]
#   Extra args come AFTER ours, so callers can override (e.g. a project's
#   own -A). Do not pass -o/-D/-w — they are used internally.

set -uo pipefail

CLIENT="wm-fetch/1.1"
CONTACT_EMAIL="luis@lu.is"
CONTACT_PAGE="https://en.wikipedia.org/wiki/User:LuisVilla"
MAX_RETRIES=4
MAX_TIME=60       # whole-request bound; a wedged socket must not hang forever
CONNECT_TIMEOUT=10

url="${1:-}"
if [ -z "$url" ]; then
  echo "usage: wm-fetch <url> [curl args...]" >&2
  exit 2
fi
shift

curl_ver="$(curl --version 2>/dev/null | head -1 | awk '{print $2}')"
UA="${CLIENT} (${CONTACT_PAGE} ${CONTACT_EMAIL}) curl/${curl_ver:-unknown}"

# maxlag is an Action API parameter; adding it elsewhere is meaningless.
case "$url" in
  *api.php*)
    if [[ "$url" != *maxlag=* ]]; then
      sep='?'; [[ "$url" == *\?* ]] && sep='&'
      url="${url}${sep}maxlag=5"
    fi
    ;;
esac

hdr=""; body=""
cleanup() { rm -f "$hdr" "$body"; }
trap cleanup EXIT INT TERM

attempt=0
while :; do
  attempt=$((attempt + 1))
  hdr="$(mktemp)"; body="$(mktemp)"
  code="$(curl -sS -L --max-redirs 3 --compressed \
    --connect-timeout "$CONNECT_TIMEOUT" --max-time "$MAX_TIME" \
    -A "$UA" -D "$hdr" -o "$body" -w '%{http_code}' "$@" "$url")" || code="000"

  if [ "$code" = "429" ] || [ "$code" = "503" ]; then
    if [ "$attempt" -ge "$MAX_RETRIES" ]; then
      echo "wm-fetch: giving up after ${attempt} attempts (HTTP ${code})" >&2
      exit 1
    fi
    # Server-stated delay wins; fall back to exponential backoff. (An
    # HTTP-date Retry-After is not numeric — the fallback covers it.)
    wait_s="$(grep -i '^retry-after:' "$hdr" | tr -d '\r' | awk '{print $2}' | head -1)"
    [[ "$wait_s" =~ ^[0-9]+$ ]] || wait_s=$((2 ** attempt))
    echo "wm-fetch: HTTP ${code}, backing off ${wait_s}s (attempt ${attempt}/${MAX_RETRIES})" >&2
    rm -f "$hdr" "$body"; hdr=""; body=""
    sleep "$wait_s"
    continue
  fi

  cat "$body"
  rm -f "$hdr" "$body"; hdr=""; body=""
  if [ "$code" = "000" ]; then
    echo "wm-fetch: request failed" >&2
    exit 1
  fi
  if [ "$code" -ge 400 ]; then
    echo "wm-fetch: HTTP ${code}" >&2
    exit 1
  fi
  break
done
